---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout>
  <main>
    <h1 style="padding-left:2rem; padding-top:2rem;">Computer Graphics 5160</h1>
    <section id="project_1" style="display:flex; flex-direction:column; padding:2rem;">
      <h2>My Fruit Worth</h2>
      <p>Pick all of the fruit growing in your garden</p>
      <a href={`${base}myFruitWorth`} class="project-link">
        <img src={`${base}myFruitWorth.png`} alt="My Fruit Worth project preview" />
      </a>
    </section>
    <a id="home" style="position:fixed; bottom:40px; left:10px; font-size:2rem; padding:2 rem" href={base}>&lt</a>
  </main>
</Layout>

<style>
  .project-link {
    display: inline-block;
    width: 35%;
    min-width: 220px;
    margin-top: 1rem;
    text-decoration: none;
  }

  .project-link img {
    display: block;
    width: 100%;
    border: 2px solid transparent;
    border-radius: 12px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .project-link:hover img {
    border-color: #1d4ed8;
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.18);
    transform: translateY(-1px);
  }
</style>